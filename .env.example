# Copy to `.env` and fill in real values. Never commit the real `.env`.

# SQLite database file used by Prisma.
DATABASE_URL="file:./prisma/dev.db"

# Signing key for the admin session cookie and the order-confirmation
# access token. REQUIRED in production — the app refuses to start without
# it rather than falling back to a known development key.
# Generate one with: openssl rand -base64 48
AUTH_SECRET=""

# Credentials for the admin user created by `npm run db:seed`.
# ADMIN_PASSWORD is REQUIRED (12+ characters) — the seed refuses to run
# without it rather than falling back to a default, since a default in
# source is a published credential.
ADMIN_EMAIL="admin@palaciodoce.pt"
ADMIN_PASSWORD=""
