# Copy to `.env` and fill in real values. Never commit the real `.env`.

# ---------------------------------------------------------------------------
# Signing key for the order-confirmation access token, which is what lets a
# customer open their own order without an account. REQUIRED in production —
# the app refuses to start without it rather than falling back to a known
# development key.
#
# The admin session is NOT signed with this: it is a Firebase session cookie,
# signed and verified by Firebase.
#
# Generate one with: openssl rand -base64 48
# ---------------------------------------------------------------------------
AUTH_SECRET=""


# ---------------------------------------------------------------------------
# Optional. Default address for `npm run admin:grant` and `admin:revoke`, so
# --email can be left off. Not a credential — administrator passwords are held
# by Firebase Auth and never stored here.
# ---------------------------------------------------------------------------
ADMIN_EMAIL=""


# ---------------------------------------------------------------------------
# Firebase — server (Admin SDK). SECRET. Never commit these.
#
# Firebase Console -> Project settings -> Service accounts -> Generate new
# private key. Copy the three values out of the downloaded JSON.
#
# FIREBASE_PRIVATE_KEY is multi-line PEM; keep it on one line with the
# newlines written as the two characters \n, exactly as shown. The app
# converts them back.
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"


# ---------------------------------------------------------------------------
# Firebase — browser. These ship in the client bundle, which is expected.
# A web API key identifies the project; it does not grant access. Authorisation
# comes from Firebase Auth plus firestore.rules.
#
# Firebase Console -> Project settings -> Your apps -> Web app -> Config
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""


# ---------------------------------------------------------------------------
# Local development against the Firebase emulator.
#
# With these set, no Firebase credentials are needed at all — the app talks to
# the local emulator instead of a real project, so local testing can never
# touch production data.
#
#   npm run emulators     # terminal 1
#   npm run dev           # terminal 2
#
# Comment all four out to point at the real project.
# ---------------------------------------------------------------------------
FIRESTORE_EMULATOR_HOST="127.0.0.1:8080"
FIREBASE_AUTH_EMULATOR_HOST="127.0.0.1:9099"
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST="127.0.0.1:9099"
