{
  "name": "palaciodoce.pt",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:messages": "node scripts/check-messages.mjs",
    "check:routes": "node scripts/check-routes.mjs",
    "check": "npm run check:messages && npm run check:routes && tsc --noEmit && npm run lint",
    "smoke": "tsx scripts/smoke-test.mjs",
    "emulators": "JAVA_HOME=\"$HOME/.local/jdk/Contents/Home\" firebase emulators:start --only firestore,auth --project demo-palaciodoce",
    "test:rules": "node scripts/test-rules.mjs",
    "test:data": "tsx scripts/test-data.ts",
    "test:auth": "node scripts/test-admin-auth.mjs",
    "admin:grant": "tsx scripts/admin-access.ts grant",
    "admin:revoke": "tsx scripts/admin-access.ts revoke",
    "admin:list": "tsx scripts/admin-access.ts list",
    "setup:production": "tsx scripts/setup-production.ts",
    "setup:apis": "node scripts/enable-apis.mjs",
    "rules:deploy": "DOTENV_CONFIG_PATH=.env.production tsx scripts/deploy-rules.ts",
    "rules:probe": "node scripts/probe-live-rules.mjs",
    "db:seed": "tsx scripts/seed-catalogue.ts",
    "db:export": "tsx scripts/export-data.ts",
    "db:restore": "tsx scripts/restore-data.ts",
    "db:import": "tsx scripts/import-data.ts",
    "prod:seed": "DOTENV_CONFIG_PATH=.env.production tsx scripts/seed-catalogue.ts",
    "prod:import": "DOTENV_CONFIG_PATH=.env.production tsx scripts/import-data.ts",
    "prod:export": "DOTENV_CONFIG_PATH=.env.production tsx scripts/export-data.ts",
    "prod:restore": "DOTENV_CONFIG_PATH=.env.production tsx scripts/restore-data.ts",
    "prod:verify": "DOTENV_CONFIG_PATH=.env.production tsx scripts/verify-production.ts",
    "vercel:env": "tsx scripts/vercel-env.ts",
    "prod:grant": "DOTENV_CONFIG_PATH=.env.production tsx scripts/admin-access.ts grant",
    "prod:revoke": "DOTENV_CONFIG_PATH=.env.production tsx scripts/admin-access.ts revoke",
    "prod:list": "DOTENV_CONFIG_PATH=.env.production tsx scripts/admin-access.ts list",
    "prod:domains": "DOTENV_CONFIG_PATH=.env.production tsx scripts/auth-domains.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "firebase": "12.4.0",
    "firebase-admin": "14.4.0",
    "jose": "^6.2.12",
    "next": "16.3.5",
    "next-intl": "^4.14.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.4",
    "slugify": "^1.6.9",
    "zod": "^4.6.5"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "firebase-tools": "^14.24.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
